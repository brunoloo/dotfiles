#!/bin/sh
# Reactiva KDE Connect (deshace kdeconnect-desactivar).
rm -f ~/.config/autostart/org.kde.kdeconnect.daemon.desktop ~/.local/share/dbus-1/services/org.kde.kdeconnect.service
dbus-send --session --type=method_call --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig
systemctl --user daemon-reload
nohup /usr/bin/kdeconnectd >/dev/null 2>&1 &
echo "KDE Connect activado (arranca solo desde el próximo inicio de sesión)."
